{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang 生成活动文件",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "-I/opt/homebrew/include",
                "-I${workspaceFolder}/engine/source",
                "-I${workspaceFolder}/source",
                "source/main.cpp",
                "source/Game.cpp",
                "engine/source/Application.cpp",
                "engine/source/CreatorEngine.cpp",
                "engine/source/input/InputManager.cpp",
                "engine/source/graphics/shaderprogram.cpp",
                "-L/opt/homebrew/lib",
                "-lglfw",
                "-lGLEW",
                "-framework",
                "OpenGL",
                "-o",
                "${workspaceFolder}/main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "调试器生成的任务。"
        },
        {
            "type": "shell",
            "label": "运行 main（外部终端）",
            "command": "open",
            "args": [
                "-a",
                "Terminal",
                "${workspaceFolder}/.vscode/run.command"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "C/C++: clang 生成活动文件",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "构建并在独立终端窗口中运行 main"
        }
    ],
    "version": "2.0.0"
}