{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "-I/opt/homebrew/include",
                "-I${workspaceFolder}/ThirdParty",
                "-I${workspaceFolder}/ThirdParty/include",
                "-I${workspaceFolder}/ThirdParty/imgui",
                "-I${workspaceFolder}/ThirdParty/imgui/backends",
                "-I${workspaceFolder}/engine/source",
                "-I${workspaceFolder}/source",
                "source/main.cpp",
                "source/Game.cpp",
                "engine/source/Application.cpp",
                "engine/source/CreatorEngine.cpp",
                "engine/source/input/InputManager.cpp",
                "engine/source/graphics/shaderprogram.cpp",
                "engine/source/graphics/Texture.cpp",
                "engine/source/graphics/Framebuffer.cpp",
                "engine/source/graphics/SpriteRenderer.cpp",
                "engine/source/graphics/SpriteBatch.cpp",
                "engine/source/graphics/Camera.cpp",
                "engine/source/core/Component.cpp",
                "engine/source/core/Transform.cpp",
                "engine/source/core/GameObject.cpp",
                "engine/source/core/Scene.cpp",
                "engine/source/core/SceneSerializer.cpp",
                "engine/source/scripting/MonoRuntime.cpp",
                "engine/source/scripting/CSharpScript.cpp",
                "engine/source/scripting/NativeHandleRegistry.cpp",
                "engine/source/editor/Editor.cpp",
                "engine/source/physics/Rigidbody2D.cpp",
                "engine/source/physics/PhysicsMaterial.cpp",
                "engine/source/physics/Collider2D.cpp",
                "engine/source/physics/BoxCollider2D.cpp",
                "engine/source/physics/CircleCollider2D.cpp",
                "engine/source/physics/PhysicsWorld.cpp",
                "ThirdParty/imgui/imgui.cpp",
                "ThirdParty/imgui/imgui_draw.cpp",
                "ThirdParty/imgui/imgui_tables.cpp",
                "ThirdParty/imgui/imgui_widgets.cpp",
                "ThirdParty/imgui/imgui_demo.cpp",
                "ThirdParty/imgui/backends/imgui_impl_glfw.cpp",
                "ThirdParty/imgui/backends/imgui_impl_opengl3.cpp",
                "-L/opt/homebrew/lib",
                "-lglfw",
                "-lGLEW",
                "-framework",
                "OpenGL",
                "-o",
                "${workspaceFolder}/main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Build all native engine modules with clang++"
        },
        {
            "type": "shell",
            "label": "Run main in Terminal",
            "command": "open",
            "args": [
                "-a",
                "Terminal",
                "${workspaceFolder}/.vscode/run.command"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "C/C++: clang++ build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build and run main in an external Terminal window"
        }
    ],
    "version": "2.0.0"
}
